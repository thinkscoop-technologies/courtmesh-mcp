{
  "name": "@courtmesh/mcp-server",
  "version": "0.1.0",
  "description": "MCP server for the CourtMesh public REST API: search and analyze 310M+ Indian court case records from Supreme Court, High Courts, District Courts and tribunals.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "courtmesh-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "indian courts",
    "legal research",
    "case law",
    "mcp",
    "model context protocol",
    "supreme court",
    "high court",
    "judgments",
    "api"
  ],
  "author": "Thinkscoop Technologies LLP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/courtmesh/courtmesh-mcp.git"
  },
  "homepage": "https://research.courtmesh.ai",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "typescript": "^5.5.4"
  }
}
